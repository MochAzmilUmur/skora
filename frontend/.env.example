# ─── Skora Flutter Environment ───────────────────────────────────────────────
#
# Salin file ini menjadi .env dan sesuaikan nilainya.
# File .env TIDAK boleh di-commit ke git.
#
# API_URL adalah satu-satunya variabel yang perlu diubah.
# Skema (http/https) menentukan otomatis:
#   - http://  → WebSocket menggunakan ws://
#   - https:// → WebSocket menggunakan wss://
#
# ─── Local Development (Android device fisik) ────────────────────────────────
# API_URL=http://192.168.x.x:8080/api
#
# ─── Local Development (Emulator) ────────────────────────────────────────────
# API_URL=http://192.168.1.6:8080/api
#
# ─── Production ──────────────────────────────────────────────────────────────
# API_URL=https://skora-backend.example.com/api

#API_URL=https://skora-backend.delightfulground-8896620c.southeastasia.azurecontainerapps.io/api
